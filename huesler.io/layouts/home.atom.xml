{{- $base := strings.TrimSuffix "/" site.BaseURL -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">

 <title>{{ site.Title }}</title>
 <link href="{{ $base }}/atom.xml" rel="self"/>
 <link href="{{ $base }}/"/>
 <updated>{{ now.Format "2006-01-02T15:04:05-07:00" }}</updated>
 <id>{{ $base }}</id>
 <author>
   <name>{{ site.Params.author.name }}</name>
 </author>

 {{ range (where site.RegularPages "Section" "posts").ByDate.Reverse }}
 <entry>
   <title>{{ .Title }}</title>
   <link href="{{ .Permalink }}"/>
   <updated>{{ .Date.Format "2006-01-02T15:04:05-07:00" }}</updated>
   {{/* Same ids as the Jekyll feed so readers don't see old posts as new. */}}
   <id>{{ $base }}/{{ .Date.Format "2006/01/02" }}/{{ .Slug }}</id>
   <content type="html">{{ .Content | html }}</content>
 </entry>
 {{ end }}

</feed>
